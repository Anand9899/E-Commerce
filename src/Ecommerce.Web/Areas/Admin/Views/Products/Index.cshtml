@model List<ProductListItemVM>
@{
    ViewData["Title"] = "Products Catalog";
}

<div class="card border rounded-4 shadow-sm p-4 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0">Products Management</h4>
            <span class="text-muted small">@Model.Count total active and drafted products</span>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Add New Product
        </a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle table-hover">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Base Price</th>
                    <th>Discount Price</th>
                    <th>Stock</th>
                    <th>Featured</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@p.PrimaryImageUrl" alt="@p.Name" class="rounded border" style="width: 48px; height: 48px; object-fit: cover;" />
                                <div>
                                    <div class="fw-semibold text-truncate" style="max-width: 220px;">@p.Name</div>
                                    <small class="text-muted">Rating: ★ @p.AverageRating (@p.TotalReviews)</small>
                                </div>
                            </div>
                        </td>
                        <td><code>@p.SKU</code></td>
                        <td><span class="badge bg-light text-dark border">@p.CategoryName</span></td>
                        <td>@p.BrandName</td>
                        <td>₹@p.BasePrice.ToString("N0")</td>
                        <td>
                            @if (p.DiscountPrice.HasValue && p.DiscountPrice.Value < p.BasePrice)
                            {
                                <span class="text-success fw-bold">₹@p.DiscountPrice.Value.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(p.StockQuantity <= 5 ? "bg-danger" : "bg-success")">
                                @p.StockQuantity in stock
                            </span>
                        </td>
                        <td>
                            @if (p.IsFeatured)
                            {
                                <span class="badge bg-primary">Featured</span>
                            }
                            else
                            {
                                <span class="text-muted small">No</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this product?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
