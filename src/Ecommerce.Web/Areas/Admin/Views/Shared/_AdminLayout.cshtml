@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal | Cartivo</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="admin-wrapper">
        <!-- Admin Sidebar Navigation -->
        <aside class="admin-sidebar shadow">
            <div class="p-4 border-bottom border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                <a class="brand-logo text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bag-heart-fill text-primary"></i>
                    <span>Cartivo</span>
                </a>
                <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1">Admin</span>
            </div>

            <div class="py-3 flex-grow-1 overflow-auto">
                <div class="admin-sidebar-section-title">Core</div>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link @(currentController == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                </a>

                <div class="admin-sidebar-section-title">Store Catalog</div>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="admin-nav-link @(currentController == "Products" ? "active" : "")">
                    <i class="bi bi-box-seam"></i> <span>Products</span>
                </a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-nav-link @(currentController == "Categories" ? "active" : "")">
                    <i class="bi bi-tags"></i> <span>Categories</span>
                </a>
                <a asp-area="Admin" asp-controller="Brands" asp-action="Index" class="admin-nav-link @(currentController == "Brands" ? "active" : "")">
                    <i class="bi bi-bookmark-star"></i> <span>Brands</span>
                </a>

                <div class="admin-sidebar-section-title">Sales & Operations</div>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="admin-nav-link @(currentController == "Orders" ? "active" : "")">
                    <i class="bi bi-receipt"></i> <span>Orders</span>
                </a>
                <a asp-area="Admin" asp-controller="Messages" asp-action="Index" class="admin-nav-link @(currentController == "Messages" ? "active" : "")">
                    <i class="bi bi-envelope-paper"></i> <span>Customer Inquiries</span>
                </a>
                <a asp-area="Admin" asp-controller="Coupons" asp-action="Index" class="admin-nav-link @(currentController == "Coupons" ? "active" : "")">
                    <i class="bi bi-percent"></i> <span>Discount Coupons</span>
                </a>
                <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="admin-nav-link @(currentController == "Reviews" ? "active" : "")">
                    <i class="bi bi-chat-square-quote"></i> <span>Customer Reviews</span>
                </a>
            </div>

            <div class="p-3 border-top border-secondary border-opacity-25 mt-auto">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light w-100 btn-sm mb-2 rounded-pill">
                    <i class="bi bi-shop me-1"></i> Visit Customer Store
                </a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger w-100 btn-sm rounded-pill">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </form>
            </div>
        </aside>

        <!-- Admin Main Content Area -->
        <div class="admin-content">
            <!-- Top Admin Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom bg-white p-3 rounded-3 shadow-sm">
                <div>
                    <h4 class="fw-bold mb-0">@ViewData["Title"]</h4>
                    <small class="text-muted">Cartivo Administration & Management Console</small>
                </div>
                <div class="d-flex align-items-center gap-3 mt-2 mt-sm-0">
                    <span class="text-muted small">Logged in as: <strong class="text-dark">@User.Identity?.Name</strong></span>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                        <i class="bi bi-box-arrow-up-right me-1"></i> View Live Site
                    </a>
                </div>
            </div>

            <!-- Flash Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
