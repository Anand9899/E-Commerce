@model List<CouponVM>
@{
    ViewData["Title"] = "Discount Coupons";
}

<div class="card border rounded-4 shadow-sm p-4 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0">Discount Coupons Management</h4>
            <span class="text-muted small">Configure percentage or flat price promotional coupons</span>
        </div>
        <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#newCouponModal">
            <i class="bi bi-plus-lg me-1"></i> Create Coupon
        </button>
    </div>

    <div class="table-responsive">
        <table class="table align-middle table-hover">
            <thead class="table-light">
                <tr>
                    <th>Coupon Code</th>
                    <th>Discount</th>
                    <th>Min Order</th>
                    <th>Max Cap</th>
                    <th>Expiry Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2 font-monospace">@c.Code</span>
                            </div>
                            <small class="text-muted">@c.Description</small>
                        </td>
                        <td class="fw-bold">
                            @(c.DiscountType == DiscountType.Percentage ? $"{c.DiscountValue}% OFF" : $"₹{c.DiscountValue:N0} OFF")
                        </td>
                        <td>₹@c.MinOrderAmount.ToString("N0")</td>
                        <td>@(c.MaxDiscountAmount.HasValue ? $"₹{c.MaxDiscountAmount.Value:N0}" : "No limit")</td>
                        <td>@c.ExpiryDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabled</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <form asp-action="ToggleStatus" asp-route-id="@c.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill">
                                        @(c.IsActive ? "Disable" : "Enable")
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this coupon?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- New Coupon Modal -->
<div class="modal fade" id="newCouponModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Create Promo Coupon</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Coupon Code *</label>
                        <input name="Code" class="form-control text-uppercase font-monospace" placeholder="e.g. FESTIVE20" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <input name="Description" class="form-control" placeholder="Short description..." />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Discount Type</label>
                            <select name="DiscountType" class="form-select">
                                <option value="Percentage">Percentage (%)</option>
                                <option value="FixedAmount">Fixed Amount (₹)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Discount Value *</label>
                            <input name="DiscountValue" type="number" step="0.01" class="form-control" placeholder="10 or 500" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Min Order Amount (₹)</label>
                            <input name="MinOrderAmount" type="number" step="0.01" class="form-control" value="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Max Discount Cap (₹)</label>
                            <input name="MaxDiscountAmount" type="number" step="0.01" class="form-control" placeholder="Optional" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Expiry Date *</label>
                        <input name="ExpiryDate" type="date" class="form-control" value="@DateTime.UtcNow.AddMonths(1).ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Coupon</button>
                </div>
            </form>
        </div>
    </div>
</div>
