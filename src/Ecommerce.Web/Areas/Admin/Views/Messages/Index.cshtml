@model List<ContactMessageListVM>
@{
    ViewData["Title"] = "Customer Inquiries & Messages";
    bool unreadOnly = ViewBag.UnreadOnly == true;
    int unreadCount = ViewBag.UnreadCount ?? 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1">Customer Inquiries & Complaints</h3>
        <p class="text-muted mb-0">Manage incoming inquiries, customer complaints, and support requests</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn @(!unreadOnly ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3 btn-sm">
            All Messages (@Model.Count)
        </a>
        <a asp-action="Index" asp-route-unreadOnly="true" class="btn @(unreadOnly ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3 btn-sm">
            Unread Only (@unreadCount)
        </a>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <div class="display-4 text-muted mb-3"><i class="bi bi-inbox"></i></div>
            <h5 class="fw-bold">No Messages Found</h5>
            <p class="text-muted">You have no customer inquiries in this folder.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Status</th>
                        <th>Sender</th>
                        <th>Subject & Preview</th>
                        <th>Received Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model)
                    {
                        <tr class="@(!msg.IsRead ? "fw-bold table-light bg-primary-subtle bg-opacity-10" : "")">
                            <td>
                                @if (!msg.IsRead)
                                {
                                    <span class="badge bg-primary text-white rounded-pill px-2 py-1 small">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> New
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">
                                        Read
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@msg.Name</div>
                                <div class="text-muted small">
                                    <a href="mailto:@msg.Email" class="text-decoration-none">@msg.Email</a>
                                    @if (!string.IsNullOrEmpty(msg.Phone))
                                    {
                                        <span class="ms-1 text-muted">| @msg.Phone</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="text-dark">@msg.Subject</div>
                                <div class="text-muted small text-truncate" style="max-width: 350px;">
                                    @msg.MessageSnippet
                                </div>
                            </td>
                            <td class="small text-muted text-nowrap">
                                @msg.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@msg.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" title="View details">
                                    <i class="bi bi-envelope-open me-1"></i> View
                                </a>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-2" title="Delete message" data-bs-toggle="modal" data-bs-target="#deleteModal_@msg.Id">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteModal_@msg.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 text-start">
                                            <form asp-action="Delete" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@msg.Id" />
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold text-danger">
                                                        <i class="bi bi-exclamation-triangle me-1"></i> Delete Message
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body py-3">
                                                    <p class="mb-1">Are you sure you want to delete this message from <strong>@msg.Name</strong>?</p>
                                                    <small class="text-muted">Subject: "@msg.Subject"</small>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Delete</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
