@model ContactMessageDetailVM
@{
    ViewData["Title"] = "Inquiry #" + Model.Id + " - " + Model.Subject;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Inquiries List
    </a>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm bg-white p-4 p-md-5">
            <div class="d-flex flex-wrap justify-content-between align-items-start border-bottom pb-4 mb-4 gap-3">
                <div>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 mb-2">
                        Inquiry #@Model.Id
                    </span>
                    <h3 class="fw-bold mb-1">@Model.Subject</h3>
                    <div class="text-muted small">
                        Received on @Model.CreatedAt.ToString("MMMM dd, yyyy at hh:mm tt")
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="mailto:@Model.Email?subject=Re: @(Uri.EscapeDataString(Model.Subject))" class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold">
                        <i class="bi bi-reply-fill me-1"></i> Reply via Email
                    </a>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#deleteDetailModal">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </div>
            </div>

            <!-- Sender Information Card -->
            <div class="p-3 bg-light rounded-4 border mb-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <small class="text-muted d-block">Customer Name</small>
                        <strong class="text-dark">@Model.Name</strong>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Email Address</small>
                        <a href="mailto:@Model.Email" class="fw-bold text-primary text-decoration-none">@Model.Email</a>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Phone / Mobile</small>
                        <strong class="text-dark">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</strong>
                    </div>
                </div>
            </div>

            <!-- Message Body -->
            <div class="mb-4">
                <h6 class="fw-bold text-uppercase fs-7 text-muted mb-3">Customer Message:</h6>
                <div class="p-4 bg-light bg-opacity-50 rounded-4 border fs-6 lh-lg text-dark" style="white-space: pre-line;">
                    @Model.Message
                </div>
            </div>

            <div class="border-top pt-4 d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    <i class="bi bi-check2-all text-success me-1"></i> Marked as Read
                </span>
                <a href="mailto:@Model.Email?subject=Re: @(Uri.EscapeDataString(Model.Subject))" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-envelope-at me-1"></i> Send Reply to @Model.Email
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal in Details -->
<div class="modal fade" id="deleteDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 text-start">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i> Delete Message
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="mb-1">Are you sure you want to delete this message permanently?</p>
                    <small class="text-muted">From: @Model.Name (@Model.Email)</small>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>
