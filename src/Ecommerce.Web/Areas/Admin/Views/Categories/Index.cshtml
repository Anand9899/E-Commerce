@model List<CategoryVM>
@{
    ViewData["Title"] = "Categories Management";
}

<div class="card border rounded-4 shadow-sm p-4 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0">Store Categories</h4>
            <span class="text-muted small">Organize your product catalog into structured sections</span>
        </div>
        <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Category
        </button>
    </div>

    <div class="table-responsive">
        <table class="table align-middle table-hover">
            <thead class="table-light">
                <tr>
                    <th>Category</th>
                    <th>Slug</th>
                    <th>Icon Class</th>
                    <th>Show on Home</th>
                    <th>Products Count</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary-subtle text-primary rounded-circle p-2 fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi @(c.IconClass ?? "bi-grid")"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">@c.Name</div>
                                    <small class="text-muted">@c.Description</small>
                                </div>
                            </div>
                        </td>
                        <td><code>@c.Slug</code></td>
                        <td><code>@(c.IconClass ?? "bi-grid")</code></td>
                        <td>
                            @if (c.ShowOnHome)
                            {
                                <span class="badge bg-success-subtle text-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">No</span>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@c.ProductCount products</span></td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- New Category Modal -->
<div class="modal fade" id="newCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add New Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category Name *</label>
                        <input name="Name" class="form-control" placeholder="e.g. Gaming & VR" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <input name="Description" class="form-control" placeholder="Short overview..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Bootstrap Icon Class</label>
                        <input name="IconClass" class="form-control" placeholder="bi-controller" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cover Image URL</label>
                        <input name="ImageUrl" class="form-control" placeholder="https://..." />
                    </div>
                    <div class="form-check form-switch">
                        <input name="ShowOnHome" class="form-check-input" type="checkbox" id="showHome" value="true" checked />
                        <label class="form-check-label fw-semibold" for="showHome">Show on Homepage</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>
