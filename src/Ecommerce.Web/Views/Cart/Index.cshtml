@model CartVM
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index">Shop</a></li>
            <li class="breadcrumb-item active" aria-current="page">Shopping Cart</li>
        </ol>
    </nav>

    <h2 class="fw-bold mb-4">Your Shopping Cart (@Model.TotalQuantity @(Model.TotalQuantity == 1 ? "item" : "items"))</h2>

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm my-4">
            <div class="display-1 text-muted"><i class="bi bi-cart-x"></i></div>
            <h3 class="fw-bold mt-3">Your Cart is Currently Empty</h3>
            <p class="text-muted">Looks like you haven't added any products to your cart yet.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 mt-2">
                <i class="bi bi-arrow-left me-1"></i> Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cart Items Table -->
            <div class="col-lg-8">
                <div class="cart-table-card shadow-sm">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 45%;">Product</th>
                                    <th scope="col" style="width: 15%;">Price</th>
                                    <th scope="col" style="width: 20%;">Quantity</th>
                                    <th scope="col" style="width: 15%;">Total</th>
                                    <th scope="col" style="width: 5%;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr id="cart-row-@item.Id">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded-3 border" style="width: 65px; height: 65px; object-fit: cover;" />
                                                <div>
                                                    <a asp-controller="Shop" asp-action="Details" asp-route-slug="@item.ProductSlug" class="fw-bold text-dark text-decoration-none">
                                                        @item.ProductName
                                                    </a>
                                                    @if (!string.IsNullOrEmpty(item.VariantName))
                                                    {
                                                        <div class="badge bg-light text-dark border small mt-1">@item.VariantName</div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">
                                            ₹@item.UnitPrice.ToString("N0")
                                        </td>
                                        <td>
                                            <div class="quantity-picker">
                                                <button type="button" onclick="updateCartQty(@item.Id, @item.Quantity - 1)">-</button>
                                                <input type="number" value="@item.Quantity" min="1" max="@item.AvailableStock" readonly />
                                                <button type="button" onclick="updateCartQty(@item.Id, @item.Quantity + 1)">+</button>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-dark" id="item-total-@item.Id">
                                            ₹@item.TotalPrice.ToString("N0")
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle" onclick="removeFromCart(@item.Id)" title="Remove">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                        </a>
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="if(confirm('Clear all items from your cart?')) { fetch('/Cart/ClearCart', {method:'POST'}).then(() => window.location.reload()); }">
                            <i class="bi bi-trash me-1"></i> Clear Cart
                        </button>
                    </div>
                </div>
            </div>

            <!-- Order Summary & Coupons Panel -->
            <div class="col-lg-4">
                <!-- Coupon Input Box -->
                <div class="card border rounded-4 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-ticket-perforated text-primary me-2"></i>Have a Coupon?</h5>
                    @if (!string.IsNullOrEmpty(Model.AppliedCouponCode))
                    {
                        <div class="alert alert-success d-flex justify-content-between align-items-center mb-0 py-2">
                            <div>
                                <span class="fw-bold">@Model.AppliedCouponCode</span>
                                <small class="d-block text-success">Coupon applied (-₹@Model.DiscountAmount.ToString("N0"))</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" onclick="removeCoupon()">Remove</button>
                        </div>
                    }
                    else
                    {
                        <div class="input-group">
                            <input type="text" id="couponCodeInput" class="form-control text-uppercase" placeholder="Enter coupon code" />
                            <button class="btn btn-primary fw-semibold" type="button" onclick="applyCoupon()">Apply</button>
                        </div>
                        <div class="mt-2 text-muted small">
                            Available codes: <strong>WELCOME10</strong> (10% off), <strong>FLAT500</strong>, <strong>SUPERDEAL</strong>
                        </div>
                    }
                </div>

                <!-- Order Summary Card -->
                <div class="order-summary-box shadow-sm">
                    <h5 class="fw-bold mb-4">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-semibold" id="cart-subtotal">₹@Model.SubTotal.ToString("N2")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Coupon Discount</span>
                            <span class="fw-semibold" id="cart-discount">-₹@Model.DiscountAmount.ToString("N2")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Estimated GST (18%)</span>
                        <span class="fw-semibold" id="cart-tax">₹@Model.TaxAmount.ToString("N2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                        <span class="text-muted">Shipping Fee</span>
                        <span class="fw-semibold text-success" id="cart-shipping">
                            @(Model.ShippingFee == 0 ? "FREE" : $"₹{Model.ShippingFee:N2}")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-5 fw-bold">Grand Total</span>
                        <span class="fs-4 fw-bold text-primary" id="cart-grandtotal">₹@Model.GrandTotal.ToString("N2")</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3">
                        Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <div class="text-center mt-3 text-muted small">
                        <i class="bi bi-shield-lock me-1"></i> Guaranteed safe & secure checkout
                    </div>
                </div>
            </div>
        </div>
    }
</div>
