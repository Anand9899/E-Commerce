@model ProductFilterVM
@{
    ViewData["Title"] = "Shop Catalog";
}

<div class="container my-4">
    <!-- Breadcrumb & Title -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Shop</li>
                    @if (!string.IsNullOrEmpty(Model.CategorySlug))
                    {
                        <li class="breadcrumb-item active text-primary">@Model.CategorySlug</li>
                    }
                </ol>
            </nav>
            <h2 class="mb-0 fw-bold">All Products (@Model.TotalItems found)</h2>
        </div>

        <!-- Sort by dropdown -->
        <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
            <label class="form-label mb-0 small fw-bold text-muted text-nowrap">Sort By:</label>
            <form id="sortForm" method="get" class="d-inline">
                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
                <input type="hidden" name="CategorySlug" value="@Model.CategorySlug" />
                <input type="hidden" name="BrandId" value="@Model.BrandId" />
                <input type="hidden" name="MinPrice" value="@Model.MinPrice" />
                <input type="hidden" name="MaxPrice" value="@Model.MaxPrice" />
                <input type="hidden" name="InStockOnly" value="@Model.InStockOnly.ToString().ToLower()" />

                <select name="SortBy" class="form-select form-select-sm" onchange="document.getElementById('sortForm').submit()">
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest Arrivals</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                    <option value="rating" selected="@(Model.SortBy == "rating")">Highest Rated</option>
                    <option value="popular" selected="@(Model.SortBy == "popular")">Most Popular</option>
                </select>
            </form>
        </div>
    </div>

    <!-- Active Search Filter Alert -->
    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <div class="alert alert-light border d-flex justify-content-between align-items-center mb-4 py-2 px-3">
            <span>Showing results for: <strong>"@Model.SearchTerm"</strong></span>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Search</a>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar Filters -->
        <div class="col-lg-3">
            <div class="card border rounded-4 p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Filters</h5>
                    <a asp-action="Index" class="text-danger small fw-semibold text-decoration-none">Reset All</a>
                </div>

                <form method="get" id="filterForm">
                    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                    <input type="hidden" name="SortBy" value="@Model.SortBy" />

                    <!-- Categories Filter -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-uppercase fs-7 text-muted mb-2">Categories</h6>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="CategoryId" id="cat_all" value="" @(Model.CategoryId == null ? "checked" : "") onchange="this.form.submit()">
                                <label class="form-check-label small" for="cat_all">All Categories</label>
                            </div>
                            @foreach (var cat in Model.Categories)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="CategoryId" id="cat_@cat.Id" value="@cat.Id" @(Model.CategoryId == cat.Id ? "checked" : "") onchange="this.form.submit()">
                                    <label class="form-check-label small d-flex justify-content-between" for="cat_@cat.Id">
                                        <span>@cat.Name</span>
                                        <span class="text-muted">(@cat.ProductCount)</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <hr class="text-muted" />

                    <!-- Brands Filter -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-uppercase fs-7 text-muted mb-2">Brands</h6>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="BrandId" id="brand_all" value="" @(Model.BrandId == null ? "checked" : "") onchange="this.form.submit()">
                                <label class="form-check-label small" for="brand_all">All Brands</label>
                            </div>
                            @foreach (var brand in Model.Brands)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="BrandId" id="brand_@brand.Id" value="@brand.Id" @(Model.BrandId == brand.Id ? "checked" : "") onchange="this.form.submit()">
                                    <label class="form-check-label small d-flex justify-content-between" for="brand_@brand.Id">
                                        <span>@brand.Name</span>
                                        <span class="text-muted">(@brand.ProductCount)</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <hr class="text-muted" />

                    <!-- Price Filter -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-uppercase fs-7 text-muted mb-2">Price Range (₹)</h6>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <input type="number" name="MinPrice" class="form-control form-control-sm" placeholder="Min ₹" value="@Model.MinPrice" />
                            </div>
                            <div class="col-6">
                                <input type="number" name="MaxPrice" class="form-control form-control-sm" placeholder="Max ₹" value="@Model.MaxPrice" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary w-100">Apply Price</button>
                    </div>

                    <hr class="text-muted" />

                    <!-- Availability -->
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="InStockOnly" id="inStockCheck" value="true" @(Model.InStockOnly ? "checked" : "") onchange="this.form.submit()">
                            <label class="form-check-label small fw-semibold" for="inStockCheck">In-Stock Only</label>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="col-lg-9">
            @if (Model.Products.Count == 0)
            {
                <div class="text-center py-5 bg-white rounded-4 border">
                    <div class="display-1 text-muted"><i class="bi bi-search"></i></div>
                    <h4 class="mt-3">No products match your criteria</h4>
                    <p class="text-muted">Try adjusting your filters or search keywords.</p>
                    <a asp-action="Index" class="btn btn-primary rounded-pill px-4">Browse All Products</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col-6 col-md-4">
                            <div class="product-card" data-href="@Url.Action("Details", "Shop", new { slug = product.Slug })">
                                <a asp-controller="Shop" asp-action="Details" asp-route-slug="@product.Slug" class="product-img-wrap">
                                    <img src="@product.PrimaryImageUrl" alt="@product.Name" loading="lazy" />
                                    <div class="product-badges">
                                        @if (product.DiscountPercentage > 0)
                                        {
                                            <span class="badge-discount">-@product.DiscountPercentage%</span>
                                        }
                                        @if (product.IsFeatured)
                                        {
                                            <span class="badge-featured">Featured</span>
                                        }
                                    </div>
                                    <button type="button" class="wishlist-btn-corner @(product.IsInWishlist ? "active" : "")" onclick="toggleWishlist(@product.Id, this); event.stopPropagation();" title="Add to Wishlist">
                                        <i class="bi @(product.IsInWishlist ? "bi-heart-fill" : "bi-heart")"></i>
                                    </button>
                                </a>

                                <div class="product-body">
                                    <div class="product-category">@product.CategoryName</div>
                                    <a asp-controller="Shop" asp-action="Details" asp-route-slug="@product.Slug" class="product-title" title="@product.Name">
                                        @product.Name
                                    </a>

                                    <div class="rating-stars mb-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(product.AverageRating))
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else if (i - product.AverageRating <= 0.5)
                                            {
                                                <i class="bi bi-star-half"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                        <span class="rating-count ms-1">(@product.TotalReviews)</span>
                                    </div>

                                    <div class="product-price-row">
                                        <div>
                                            <span class="price-current">₹@product.EffectivePrice.ToString("N0")</span>
                                            @if (product.DiscountPrice.HasValue && product.DiscountPrice.Value < product.BasePrice)
                                            {
                                                <span class="price-old">₹@product.BasePrice.ToString("N0")</span>
                                            }
                                        </div>
                                        <button type="button" class="btn-add-cart-mini" onclick="addToCart(@product.Id); event.stopPropagation();" title="Add to Cart">
                                            <i class="bi bi-bag-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5" aria-label="Catalog navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-brandId="@Model.BrandId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sortBy="@Model.SortBy">
                                    Previous
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-pageNumber="@i"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-categoryId="@Model.CategoryId"
                                       asp-route-brandId="@Model.BrandId"
                                       asp-route-minPrice="@Model.MinPrice"
                                       asp-route-maxPrice="@Model.MaxPrice"
                                       asp-route-sortBy="@Model.SortBy">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-brandId="@Model.BrandId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sortBy="@Model.SortBy">
                                    Next
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
