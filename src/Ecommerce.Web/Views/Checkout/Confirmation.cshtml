@model OrderDetailVM
@{
    ViewData["Title"] = "Order Confirmed - " + Model.OrderNumber;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Celebration Banner -->
            <div class="card border-0 rounded-4 shadow-sm text-center p-5 mb-4" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff;">
                <div class="display-1 mb-3"><i class="bi bi-patch-check-fill"></i></div>
                <h2 class="fw-bold mb-2 text-white">Thank You! Your Order is Confirmed</h2>
                <p class="lead text-white-50 mb-3">We have received your order and our logistics team is preparing your package.</p>
                <div class="d-inline-block bg-white bg-opacity-20 backdrop-blur rounded-pill px-4 py-2 fw-bold text-white fs-5">
                    Order Number: <strong>@Model.OrderNumber</strong>
                </div>
            </div>

            <!-- Receipt & Invoice Card -->
            <div class="card border rounded-4 shadow-sm p-4 p-md-5 mb-4 bg-white" id="invoiceReceipt">
                <div class="d-flex justify-content-between align-items-center pb-4 border-bottom mb-4">
                    <div>
                        <h4 class="fw-bold mb-0">Order Receipt</h4>
                        <span class="text-muted small">Placed on @Model.OrderDate.ToString("MMMM dd, yyyy hh:mm tt")</span>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-success-subtle text-success fs-6 fw-bold px-3 py-2">@Model.Status</span>
                        <div class="text-muted small mt-1">Payment: @Model.PaymentMethod (@Model.PaymentStatus)</div>
                    </div>
                </div>

                <!-- Shipping Address Snapshot -->
                <div class="row g-4 mb-4 pb-4 border-bottom">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-uppercase fs-7 text-muted mb-2">Delivery Address</h6>
                        <div class="fw-bold text-dark">@Model.ShippingFullName</div>
                        <div class="text-muted small">@Model.ShippingAddressLine1 @Model.ShippingAddressLine2</div>
                        <div class="text-muted small">@Model.ShippingCity, @Model.ShippingState - @Model.ShippingPostalCode, @Model.ShippingCountry</div>
                        <div class="text-muted small">Phone: @Model.ShippingPhone</div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <h6 class="fw-bold text-uppercase fs-7 text-muted mb-2">Payment Details</h6>
                        <div>Method: <strong>@Model.PaymentMethod</strong></div>
                        <div>Status: <span class="badge @(Model.PaymentStatus == PaymentStatus.Paid ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") border">@Model.PaymentStatus</span></div>
                        @if (!string.IsNullOrEmpty(Model.TransactionId))
                        {
                            <div class="small text-muted mt-1">Ref/UTR: <span class="badge bg-light text-dark border font-monospace">@Model.TransactionId</span></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.CouponCode))
                        {
                            <div class="text-success small mt-1">Coupon: <strong>@Model.CouponCode</strong></div>
                        }
                    </div>
                </div>

                <!-- Items Table -->
                <div class="table-responsive mb-4">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@item.ProductImageUrl" alt="@item.ProductName" class="rounded border" style="width: 45px; height: 45px; object-fit: cover;" />
                                            <div>
                                                <div class="fw-semibold">@item.ProductName</div>
                                                @if (!string.IsNullOrEmpty(item.VariantName))
                                                {
                                                    <small class="text-muted">@item.VariantName</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">₹@item.UnitPrice.ToString("N0")</td>
                                    <td class="text-end fw-bold">₹@item.TotalPrice.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Totals -->
                <div class="row justify-content-end">
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal:</span>
                            <span>₹@Model.SubTotal.ToString("N2")</span>
                        </div>
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Discount:</span>
                                <span>-₹@Model.DiscountAmount.ToString("N2")</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">GST (18%):</span>
                            <span>₹@Model.TaxAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Shipping Fee:</span>
                            <span class="text-success">@(Model.ShippingFee == 0 ? "FREE" : $"₹{Model.ShippingFee:N2}")</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2 fs-5 fw-bold text-dark">
                            <span>Grand Total:</span>
                            <span class="text-primary">₹@Model.GrandTotal.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <a asp-controller="Orders" asp-action="Invoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-file-earmark-pdf me-1"></i> Download Tax Invoice
                </a>
                <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4 py-2">
                    <i class="bi bi-box-seam me-1"></i> Track Order Status
                </a>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 border">
                    Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>
