@model ContactFormVM
@{
    ViewData["Title"] = "Contact Us & Support";
}

<div class="container my-5">
    <div class="row g-5">
        <div class="col-lg-6">
            <span class="text-primary fw-bold text-uppercase fs-7">Get In Touch</span>
            <h1 class="display-6 fw-bold mb-3">We're here to help you</h1>
            <p class="text-muted mb-4">Have questions regarding an order, payment, returns, complaint or business inquiry? Reach out to our dedicated support team anytime.</p>

            <div class="d-flex flex-column gap-4 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary rounded-circle p-3 fs-4"><i class="bi bi-geo-alt"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Headquarters</h6>
                        <span class="text-muted">Tower B, Cyber Tech Park, Sector 62, Noida, UP - 201309</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success-subtle text-success rounded-circle p-3 fs-4"><i class="bi bi-telephone"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Phone / WhatsApp</h6>
                        <span class="text-muted">+91 (120) 456-7890 / +91 98765 43210</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-info-subtle text-info rounded-circle p-3 fs-4"><i class="bi bi-envelope"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Email Support</h6>
                        <span class="text-muted">support@cartivo.com | anandmishra02.com@gmail.com</span>
                    </div>
                </div>
            </div>

            <!-- Quick WhatsApp Support Banner -->
            <div class="p-3 bg-success bg-opacity-10 border border-success-subtle rounded-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-whatsapp text-success fs-3"></i>
                    <div>
                        <div class="fw-bold text-dark">Need Quick Assistance?</div>
                        <small class="text-muted">Chat directly with support on WhatsApp</small>
                    </div>
                </div>
                <a href="https://wa.me/919576989908" target="_blank" class="btn btn-success btn-sm rounded-pill px-3">
                    <i class="bi bi-chat-dots-fill me-1"></i> WhatsApp
                </a>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm">
                <h4 class="fw-bold mb-1">Send us a message</h4>
                <p class="text-muted small mb-4">Fill in the details below and your message will be forwarded directly to our support desk.</p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Your Name *</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter Your Name" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address *</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="Enter Register Email ID" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Phone" class="form-label fw-semibold">Mobile Number</label>
                            <input asp-for="Phone" class="form-control" placeholder="Enter Register Mobile Number" maxlength="15" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold">Subject / Complaint Type *</label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Order Delivery status, Payment question, Feedback..." required />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Message" class="form-label fw-semibold">Message / Inquiry Details *</label>
                        <textarea asp-for="Message" class="form-control" rows="4" placeholder="Please describe your question or complaint in detail..." required></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-pill shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
