                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    // Real-Time 24-Hour Flash Sale Reverse Countdown Timer
    function startFlashSaleTimer() {
        const hEl = document.getElementById('timerHours');
        const mEl = document.getElementById('timerMinutes');
        const sEl = document.getElementById('timerSeconds');

        if (!hEl || !mEl || !sEl) return;

        function updateTimer() {
            const now = new Date();
            // Calculate time until next midnight (IST / Local)
            const midnight = new Date(now);
            midnight.setHours(24, 0, 0, 0);

            let diffMs = midnight - now;
            if (diffMs <= 0) {
                diffMs = 24 * 60 * 60 * 1000; // Reset for next cycle
            }

            const hours = Math.floor(diffMs / (1000 * 60 * 60));
            const minutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diffMs % (1000 * 60)) / 1000);

            hEl.innerText = String(hours).padStart(2, '0');
            mEl.innerText = String(minutes).padStart(2, '0');
            sEl.innerText = String(seconds).padStart(2, '0');
        }

        updateTimer();
        setInterval(updateTimer, 1000);
    }

    window.addEventListener('DOMContentLoaded', startFlashSaleTimer);
</script>
}
