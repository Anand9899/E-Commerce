<!-- ================= ⚡ MEGA FLASH SALE & DEAL OF THE DAY SECTION ================= -->
<div class="container my-5">
    <div class="p-4 p-md-5 rounded-4 border shadow-sm position-relative overflow-hidden" 
         style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%); color: #ffffff;">
        
        <!-- Flash Sale Header with Live Countdown Timer -->
        <div class="d-flex flex-wrap justify-content-between align-items-center pb-4 mb-4 border-bottom border-white border-opacity-20">
            <div class="d-flex align-items-center gap-3 mb-3 mb-md-0">
                <div class="bg-danger text-white rounded-circle p-2 d-flex align-items-center justify-content-center shadow" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h3 class="fw-bold text-white mb-0">24-Hour Flash Sale</h3>
                        <span class="badge bg-danger text-white text-uppercase px-2 py-1 rounded-pill" style="font-size: 0.7rem; animation: pulse 1.5s infinite;">
                            <i class="bi bi-broadcast me-1"></i> LIVE
                        </span>
                    </div>
                    <p class="text-white-50 small mb-0">Deals refresh daily at midnight. Limited stock available at special prices.</p>
                </div>
            </div>

            <!-- Countdown Timer Boxes -->
            <div class="d-flex align-items-center gap-2">
                <span class="text-white-50 small fw-bold text-uppercase d-none d-sm-inline me-2">Offers End In:</span>
                <div class="d-flex gap-2 text-center" id="flashSaleTimer">
                    <div class="bg-black bg-opacity-40 border border-white border-opacity-25 rounded-3 px-3 py-2" style="min-width: 58px;">
                        <span class="fw-bold fs-5 text-white mono d-block" id="timerHours">04</span>
                        <small class="text-white-50 text-uppercase" style="font-size: 0.65rem;">Hours</small>
                    </div>
                    <span class="fs-4 fw-bold text-white-50 align-self-center">:</span>
                    <div class="bg-black bg-opacity-40 border border-white border-opacity-25 rounded-3 px-3 py-2" style="min-width: 58px;">
                        <span class="fw-bold fs-5 text-white mono d-block" id="timerMinutes">28</span>
                        <small class="text-white-50 text-uppercase" style="font-size: 0.65rem;">Mins</small>
                    </div>
                    <span class="fs-4 fw-bold text-white-50 align-self-center">:</span>
                    <div class="bg-black bg-opacity-40 border border-white border-opacity-25 rounded-3 px-3 py-2" style="min-width: 58px;">
                        <span class="fw-bold fs-5 text-warning mono d-block" id="timerSeconds">45</span>
                        <small class="text-white-50 text-uppercase" style="font-size: 0.65rem;">Secs</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 align-items-stretch">
            <!-- Left: Deal of the Day Spotlight -->
            @if (dealOfTheDay != null)
            {
                <div class="col-lg-5">
                    <div class="card h-100 border-0 rounded-4 p-4 text-dark shadow position-relative" style="background: #ffffff;">
                        <div class="position-absolute top-0 start-0 m-3 z-2">
                            <span class="badge bg-danger text-white px-3 py-2 rounded-pill fw-bold shadow-sm" style="font-size: 0.8rem;">
                                <i class="bi bi-fire me-1"></i> DEAL OF THE DAY
                            </span>
                        </div>

                        <div class="text-center p-3 mb-3" style="min-height: 220px; display: flex; align-items: center; justify-content: center;">
                            <img src="@dealOfTheDay.PrimaryImageUrl" alt="@dealOfTheDay.Name" class="img-fluid rounded-3" style="max-height: 200px; object-fit: contain;" />
                        </div>

                        <div class="d-flex flex-column flex-grow-1 justify-content-between">
                            <div>
                                <span class="badge bg-primary-subtle text-primary text-uppercase px-2 py-1 mb-2" style="font-size: 0.75rem;">@dealOfTheDay.CategoryName</span>
                                <h5 class="fw-bold text-dark mb-2">@dealOfTheDay.Name</h5>
                                
                                <div class="d-flex align-items-baseline gap-2 mb-3">
                                    <span class="fs-3 fw-bold text-dark">₹@dealOfTheDay.EffectivePrice.ToString("N0")</span>
                                    @if (dealOfTheDay.DiscountPrice.HasValue && dealOfTheDay.DiscountPrice.Value < dealOfTheDay.BasePrice)
                                    {
                                        <span class="fs-6 text-muted text-decoration-line-through">₹@dealOfTheDay.BasePrice.ToString("N0")</span>
                                        <span class="badge bg-success text-white">Save @dealOfTheDay.DiscountPercentage%</span>
                                    }
                                </div>

                                <!-- Animated Stock Claimed Progress Bar -->
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between small fw-bold mb-1">
                                        <span class="text-danger"><i class="bi bi-fire me-1"></i> Almost Sold Out!</span>
                                        <span class="text-muted">82% Claimed</span>
                                    </div>
                                    <div class="progress rounded-pill" style="height: 8px; background-color: #f1f5f9;">
                                        <div class="progress-bar bg-danger progress-bar-striped progress-bar-animated" role="progressbar" style="width: 82%;"></div>
                                    </div>
                                    <small class="text-muted d-block mt-1">Hurry, only a few units left at this festive discount!</small>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-controller="Shop" asp-action="Details" asp-route-slug="@dealOfTheDay.Slug" class="btn btn-outline-primary rounded-pill px-3 flex-grow-1 fw-semibold">
                                    View Deal
                                </a>
                                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-1"
                                        onclick="buyNow(@dealOfTheDay.Id, null, 1, this)">
                                    <i class="bi bi-lightning-charge-fill"></i> Buy Now
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Right: 4-Item Flash Deals Grid -->
            <div class="col-lg-7">
                <div class="row g-3 h-100">
                    @foreach (var prod in flashProducts)
                    {
                        <div class="col-sm-6">
                            <div class="card h-100 border-0 rounded-4 p-3 bg-white text-dark shadow-sm d-flex flex-column justify-content-between" style="transition: transform 0.2s ease;">
                                <div>
                                    <div class="position-relative text-center mb-2" style="height: 120px; display: flex; align-items: center; justify-content: center;">
                                        <img src="@prod.PrimaryImageUrl" alt="@prod.Name" class="img-fluid rounded-2" style="max-height: 110px; object-fit: contain;" />
                                        @if (prod.DiscountPercentage > 0)
                                        {
                                            <span class="position-absolute top-0 start-0 badge bg-danger text-white rounded-pill px-2 py-1" style="font-size: 0.7rem;">
                                                -@prod.DiscountPercentage%
                                            </span>
                                        }
                                    </div>

                                    <div class="small text-muted mb-1 text-truncate">@prod.CategoryName</div>
                                    <a asp-controller="Shop" asp-action="Details" asp-route-slug="@prod.Slug" class="text-dark text-decoration-none fw-bold small d-block mb-2 text-truncate" title="@prod.Name">
                                        @prod.Name
                                    </a>

                                    <div class="d-flex align-items-baseline gap-2 mb-2">
                                        <span class="fw-bold text-dark">₹@prod.EffectivePrice.ToString("N0")</span>
                                        @if (prod.DiscountPrice.HasValue && prod.DiscountPrice.Value < prod.BasePrice)
                                        {
                                            <span class="text-muted text-decoration-line-through small" style="font-size: 0.75rem;">₹@prod.BasePrice.ToString("N0")</span>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex gap-2 mt-2">
                                    <a asp-controller="Shop" asp-action="Details" asp-route-slug="@prod.Slug" class="btn btn-outline-secondary btn-sm rounded-pill flex-grow-1" style="font-size: 0.75rem;">
                                        Details
                                    </a>
                                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" onclick="addToCart(@prod.Id)" title="Quick Add">
                                        <i class="bi bi-bag-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Explore Categories -->
