<!-- Featured Products Section -->
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <span class="text-primary fw-bold text-uppercase fs-7">Curated Picks</span>
            <h2 class="mb-0">Featured Products</h2>
        </div>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            See More <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row g-4">
        @foreach (var product in featuredProducts)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="product-card" data-href="@Url.Action("Details", "Shop", new { slug = product.Slug })">
                    <a asp-controller="Shop" asp-action="Details" asp-route-slug="@product.Slug" class="product-img-wrap">
                        <img src="@product.PrimaryImageUrl" alt="@product.Name" loading="lazy" />
                        <div class="product-badges">
                            @if (product.DiscountPercentage > 0)
                            {
                                <span class="badge-discount">-@product.DiscountPercentage%</span>
                            }
                            @if (product.IsFeatured)
                            {
                                <span class="badge-featured">Featured</span>
                            }
                        </div>
                        <button type="button" class="wishlist-btn-corner @(product.IsInWishlist ? "active" : "")" onclick="toggleWishlist(@product.Id, this); event.stopPropagation();" title="Add to Wishlist">
                            <i class="bi @(product.IsInWishlist ? "bi-heart-fill" : "bi-heart")"></i>
                        </button>
                    </a>

                    <div class="product-body">
                        <div class="product-category">@product.CategoryName</div>
                        <a asp-controller="Shop" asp-action="Details" asp-route-slug="@product.Slug" class="product-title" title="@product.Name">
                            @product.Name
                        </a>

                        <div class="rating-stars mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Floor(product.AverageRating))
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else if (i - product.AverageRating <= 0.5)
                                {
                                    <i class="bi bi-star-half"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }
                            <span class="rating-count ms-1">(@product.TotalReviews)</span>
                        </div>

                        <div class="product-price-row">
                            <div>
                                <span class="price-current">₹@product.EffectivePrice.ToString("N0")</span>
                                @if (product.DiscountPrice.HasValue && product.DiscountPrice.Value < product.BasePrice)
                                {
                                    <span class="price-old">₹@product.BasePrice.ToString("N0")</span>
                                }
                            </div>
                            <button type="button" class="btn-add-cart-mini" onclick="addToCart(@product.Id); event.stopPropagation();" title="Add to Cart">
                                <i class="bi bi-bag-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

