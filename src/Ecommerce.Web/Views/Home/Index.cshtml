            </div>
            <div class="d-flex gap-2 flex-shrink-0">
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Shop")" class="btn btn-outline-primary rounded-pill px-4">Sign In</a>
                <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Url.Action("Index", "Shop")" class="btn btn-primary rounded-pill px-4 shadow-sm">Sign Up Now</a>
            </div>
        </div>
