@{
    ViewData["Title"] = "Home - Elevate Your Lifestyle";
    var featuredProducts = ViewBag.FeaturedProducts as List<ProductListItemVM> ?? new List<ProductListItemVM>();
    var trendingProducts = ViewBag.TrendingProducts as List<ProductListItemVM> ?? new List<ProductListItemVM>();
    var categories = ViewBag.Categories as List<CategoryVM> ?? new List<CategoryVM>();

    // Pick a flagship deal of the day product
    var dealOfTheDay = featuredProducts.FirstOrDefault(p => p.DiscountPercentage > 0) ?? featuredProducts.FirstOrDefault() ?? trendingProducts.FirstOrDefault();
    var flashProducts = featuredProducts.Where(p => p.DiscountPercentage > 0).Take(4).ToList();
    if (flashProducts.Count == 0)
    {
        flashProducts = featuredProducts.Take(4).ToList();
    }
}

<div class="container my-4">
    <!-- Hero Slider Banner -->
    <div class="hero-slider-card">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <span class="hero-tag"><i class="bi bi-fire text-warning me-1"></i> Special Launch Event</span>
                <h1 class="hero-title text-white">Next-Gen Tech & Premium Fashion</h1>
                <p class="hero-subtitle">
                    Discover handpicked flagship smartphones, laptops, high-performance running shoes, and lifestyle essentials with flat discounts.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4">
                        Shop Now <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                    <a asp-controller="Shop" asp-action="Category" asp-route-slug="electronics" class="btn btn-outline-light btn-lg rounded-pill px-4">
                        Explore Electronics
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=800&auto=format&fit=crop&q=80" alt="MacBook Pro" class="img-fluid hero-product-img rounded-4" />
            </div>
        </div>
    </div>
</div>

@if (User.Identity?.IsAuthenticated != true)
{
    <!-- Guest Customer Welcome Banner -->
    <div class="container my-3">
        <div class="card border-0 rounded-4 shadow-sm p-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3" style="background: #ffffff; border: 1px solid rgba(79, 70, 229, 0.12) !important; box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 50px; height: 50px; font-size: 1.5rem; background: rgba(79, 70, 229, 0.1); color: #4f46e5;">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1 text-dark">Start Shopping Today!</h5>
                    <p class="text-muted mb-0 small">Please <strong class="text-dark">Sign In</strong> or <strong class="text-dark">Create a Customer Account</strong> to browse our curated catalogue, add items to cart, and enjoy member-exclusive discounts.</p>
