@{
    ViewData["Title"] = "About Us";
}

<div class="container my-5">
    <div class="row align-items-center mb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <span class="text-primary fw-bold text-uppercase fs-7">Our Story</span>
            <h1 class="display-5 fw-bold mb-3">Empowering Modern Commerce with High Standards</h1>
            <p class="lead text-muted">
                Cartivo was built on the foundation of delivering top-tier genuine electronics, fashion, and lifestyle essentials with ultra-fast fulfillment and transparent customer support.
            </p>
            <p class="text-muted">
                Our platform combines cutting-edge .NET 8 architecture, seamless multi-channel logistics, and verified buyer reviews to ensure every order exceeds your expectations.
            </p>
        </div>
        <div class="col-lg-6">
            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&auto=format&fit=crop&q=80" alt="Team" class="img-fluid rounded-4 shadow" />
        </div>
    </div>

    <div class="row g-4 my-5 text-center">
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border">
                <div class="text-primary fs-1 mb-2"><i class="bi bi-award"></i></div>
                <h4 class="fw-bold">100% Authentic</h4>
                <p class="text-muted mb-0">Every product is sourced directly from certified brand distributors.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border">
                <div class="text-success fs-1 mb-2"><i class="bi bi-lightning-charge"></i></div>
                <h4 class="fw-bold">Lightning Fast</h4>
                <p class="text-muted mb-0">Express dispatch within 24 hours with end-to-end live tracking.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border">
                <div class="text-info fs-1 mb-2"><i class="bi bi-shield-lock"></i></div>
                <h4 class="fw-bold">Bank-Grade Security</h4>
                <p class="text-muted mb-0">Your transactions and personal data are safeguarded with 256-bit encryption.</p>
            </div>
        </div>
    </div>
</div>
