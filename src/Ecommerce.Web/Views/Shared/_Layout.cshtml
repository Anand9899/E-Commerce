@using Microsoft.AspNetCore.Identity
@using Ecommerce.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cartivo | Modern E-Commerce</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Announcement Bar -->
    <div class="top-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span><i class="bi bi-truck me-1"></i> Free Express Shipping on orders over ₹999</span>
                <span class="ms-3"><i class="bi bi-tag-fill me-1 text-warning"></i> Use Code <span class="promo-code ms-1 me-1">WELCOME10</span> for 10% OFF</span>
            </div>
            <div>
                <span class="me-3"><i class="bi bi-shield-check me-1"></i> 100% Secure Checkout</span>
                <span><i class="bi bi-headset me-1"></i> 24/7 Support: +91 95769 89908</span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="main-navbar">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <!-- Brand Logo -->
                <a class="brand-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bag-heart-fill text-primary"></i>
                    <span>Cartivo</span>
                </a>

                <!-- Search Bar -->
                <form class="search-bar-wrap d-none d-lg-block position-relative" asp-controller="Shop" asp-action="Index" method="get" id="desktopSearchForm">
                    <input type="text" name="SearchTerm" id="desktopSearchInput" class="form-control search-bar-input" placeholder="Search smartphones, laptops, fashion, shoes..." value="@Context.Request.Query["SearchTerm"]" autocomplete="off" />
                    <button type="submit" class="search-bar-btn" title="Search">
                        <i class="bi bi-search"></i>
                    </button>
                    <!-- Instant Live Search Dropdown -->
                    <div id="desktopQuickSearchResults" class="quick-search-dropdown shadow-lg d-none"></div>
                </form>

                <!-- Navigation Links & Action Badges -->
                <div class="d-flex align-items-center gap-2 gap-md-3">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-primary d-none d-sm-inline-flex align-items-center gap-2 py-2">
                        <i class="bi bi-grid"></i>
                        <span>Explore Shop</span>
                    </a>

                    <!-- Wishlist -->
                    <a asp-controller="Wishlist" asp-action="Index" class="nav-icon-link" title="Wishlist">
                        <i class="bi bi-heart"></i>
                        <span id="navWishlistCount" class="badge-counter" style="display:none;">0</span>
                    </a>

                    <!-- Cart -->
                    <a asp-controller="Cart" asp-action="Index" class="nav-icon-link" title="Cart">
                        <i class="bi bi-bag"></i>
                        <span id="navCartCount" class="badge-counter" style="display:none;">0</span>
                    </a>

                    <!-- User Account / Login Dropdown -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        bool isAdmin = User.IsInRole("Admin");

                        <div class="dropdown">
                            <button class="btn btn-outline-secondary rounded-pill dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 text-dark border shadow-sm bg-white" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (currentUser?.Gender == "Female")
                                {
                                    <img src="~/images/avatars/female-avatar.png" asp-append-version="true" class="rounded-circle shadow-sm border border-danger-subtle" width="28" height="28" style="object-fit:cover; object-position:top;" alt="Woman Avatar" />
                                }
                                else if (currentUser?.Gender == "Male")
                                {
                                    <img src="~/images/avatars/male-avatar.png" asp-append-version="true" class="rounded-circle shadow-sm border border-primary-subtle" width="28" height="28" style="object-fit:cover; object-position:top;" alt="Man Avatar" />
                                }
                                else
                                {
                                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@(Uri.EscapeDataString(currentUser?.FullName ?? "Alex"))&backgroundColor=d1d4f9" class="rounded-circle shadow-sm border border-secondary-subtle" width="28" height="28" style="object-fit:cover;" alt="User Avatar" />
                                }
                                <span class="d-none d-md-inline fw-semibold text-dark">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-0 rounded-4 overflow-hidden" style="min-width: 260px;">
                                <!-- User Profile Card Link Header -->
                                <li class="p-3 bg-light border-bottom">
                                    <a asp-controller="Account" asp-action="Profile" class="text-decoration-none text-dark d-flex align-items-center gap-3">
                                        @if (currentUser?.Gender == "Female")
                                        {
                                            <img src="~/images/avatars/female-avatar.png" asp-append-version="true" class="rounded-circle shadow-sm border border-2 border-danger-subtle flex-shrink-0" width="44" height="44" style="object-fit:cover; object-position:top;" alt="Woman Avatar" />
                                        }
                                        else if (currentUser?.Gender == "Male")
                                        {
                                            <img src="~/images/avatars/male-avatar.png" asp-append-version="true" class="rounded-circle shadow-sm border border-2 border-primary-subtle flex-shrink-0" width="44" height="44" style="object-fit:cover; object-position:top;" alt="Man Avatar" />
                                        }
                                        else
                                        {
                                            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@(Uri.EscapeDataString(currentUser?.FullName ?? "Alex"))&backgroundColor=d1d4f9" class="rounded-circle shadow-sm border border-2 border-secondary-subtle flex-shrink-0" width="44" height="44" style="object-fit:cover;" alt="User Avatar" />
                                        }
                                        <div class="overflow-hidden">
                                            <div class="fw-bold text-truncate" style="max-width: 170px;">@(currentUser?.FullName ?? "My Profile")</div>
                                            <div class="text-muted small text-truncate" style="max-width: 170px;">@(currentUser?.Email ?? User.Identity?.Name)</div>
                                            <span class="badge bg-primary text-white mt-1 py-1 px-2" style="font-size: 0.72rem;">
                                                <i class="bi bi-person-circle me-1"></i> View Profile
                                            </span>
                                        </div>
                                    </a>
                                </li>
                                <div class="p-2">
                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item rounded-3 py-2 text-primary fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i> Admin Portal
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-primary"></i> Profile & Details
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Account" asp-action="Wallet">
                                            <i class="bi bi-wallet2 me-2 text-primary"></i> My Wallet & Rewards
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Orders" asp-action="Index">
                                            <i class="bi bi-box-seam me-2 text-success"></i> My Orders
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Wishlist" asp-action="Index">
                                            <i class="bi bi-heart me-2 text-danger"></i> My Wishlist
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Account" asp-action="Addresses">
                                            <i class="bi bi-geo-alt me-2 text-warning"></i> Saved Addresses
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Home" asp-action="Contact">
                                            <i class="bi bi-chat-left-dots-fill me-2 text-info"></i> Inquiry & Complaints
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item rounded-3 py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </div>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary rounded-pill px-3 py-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill px-3 py-2">
                                <i class="bi bi-person-plus me-1"></i> Sign Up
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Mobile Search Bar -->
            <form class="mt-3 d-lg-none position-relative" asp-controller="Shop" asp-action="Index" method="get" id="mobileSearchForm">
                <div class="input-group">
                    <input type="text" name="SearchTerm" id="mobileSearchInput" class="form-control" placeholder="Search products..." value="@Context.Request.Query["SearchTerm"]" autocomplete="off" />
                    <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
                </div>
                <!-- Instant Live Search Dropdown for Mobile -->
                <div id="mobileQuickSearchResults" class="quick-search-dropdown shadow-lg d-none"></div>
            </form>
        </div>

        <!-- Category Sub-Navigation Bar -->
        <div class="category-subnav border-top bg-white">
            <div class="container">
                <div class="d-flex align-items-center justify-content-between overflow-x-auto py-2 gap-3 no-scrollbar">
                    <div class="d-flex align-items-center gap-2 gap-lg-3 flex-shrink-0">
                        <a asp-controller="Shop" asp-action="Index" class="cat-nav-pill active">
                            <i class="bi bi-grid-fill text-primary"></i>
                            <span>All</span>
                        </a>
                        <a asp-controller="Shop" asp-action="Category" asp-route-slug="mens-fashion" class="cat-nav-pill">
                            <i class="bi bi-person-standing text-primary"></i>
                            <span>Men's Fashion</span>
                        </a>
                        <a asp-controller="Shop" asp-action="Category" asp-route-slug="womens-fashion" class="cat-nav-pill">
                            <i class="bi bi-person-standing-dress text-danger"></i>
                            <span>Women's Fashion</span>
                        </a>
                        <a asp-controller="Shop" asp-action="Category" asp-route-slug="electronics" class="cat-nav-pill">
                            <i class="bi bi-laptop text-info"></i>
                            <span>Electronics</span>
                        </a>
                        <a asp-controller="Shop" asp-action="Category" asp-route-slug="home-kitchen" class="cat-nav-pill">
                            <i class="bi bi-house-door text-warning"></i>
                            <span>Home & Kitchen</span>
                        </a>
                        <a asp-controller="Shop" asp-action="Category" asp-route-slug="beauty-personal-care" class="cat-nav-pill">
                            <i class="bi bi-stars text-pink"></i>
                            <span>Beauty & Care</span>
                        </a>
                        <a asp-controller="Shop" asp-action="Category" asp-route-slug="sports-fitness" class="cat-nav-pill">
                            <i class="bi bi-trophy text-success"></i>
                            <span>Sports</span>
                        </a>
                        <a asp-controller="Shop" asp-action="Category" asp-route-slug="books-stationery" class="cat-nav-pill">
                            <i class="bi bi-book text-secondary"></i>
                            <span>Books</span>
                        </a>
                    </div>
                    <div class="d-none d-xl-block flex-shrink-0">
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold small">
                            <i class="bi bi-lightning-charge-fill me-1"></i> Clothing & Festive Deals Up to 60% OFF
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Alert Notifications -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Area -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row g-4 mb-5">
                <div class="col-lg-4 col-md-6">
                    <a class="brand-logo mb-3 d-inline-flex text-decoration-none" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-bag-heart-fill text-primary"></i>
                        <span>Cartivo</span>
                    </a>
                    <p class="text-secondary pe-lg-4">
                        Your premium online destination for top-quality electronics, trendy fashion, home essentials, and lifestyle products with instant delivery and secure checkout.
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="social-link" title="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-link" title="Twitter/X"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-link" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-link" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h5>Categories</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a asp-controller="Shop" asp-action="Category" asp-route-slug="mens-fashion">Men's Fashion</a></li>
                        <li><a asp-controller="Shop" asp-action="Category" asp-route-slug="womens-fashion">Women's Fashion</a></li>
                        <li><a asp-controller="Shop" asp-action="Category" asp-route-slug="electronics">Electronics</a></li>
                        <li><a asp-controller="Shop" asp-action="Category" asp-route-slug="home-kitchen">Home & Kitchen</a></li>
                        <li><a asp-controller="Shop" asp-action="Category" asp-route-slug="beauty-personal-care">Beauty</a></li>
                        <li><a asp-controller="Shop" asp-action="Category" asp-route-slug="sports-fitness">Sports</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h5>Customer Care</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a asp-controller="Orders" asp-action="Index">Track Order</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Shopping Cart</a></li>
                        <li><a asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact & Complaints</a></li>
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h5>Stay in the Loop</h5>
                    <p class="text-secondary">Subscribe to receive exclusive festive deals, new product drops, and discount coupons directly.</p>
                    <form class="d-flex gap-2" onsubmit="event.preventDefault(); showToast('success', 'Thank you for subscribing!');">
                        <input type="email" class="form-control" placeholder="Enter your email" required />
                        <button type="submit" class="btn btn-primary px-4">Join</button>
                    </form>
                </div>
            </div>

            <div class="border-top pt-4 text-center text-secondary small" style="border-color: #e2e8f0 !important;">
                <p class="mb-0">&copy; @DateTime.UtcNow.Year Cartivo Technologies Inc. Built with ASP.NET Core 8 MVC & SQL Server.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
