@model List<OrderListVM>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Orders</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Order History (@Model.Count)</h2>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="bi bi-bag-plus me-1"></i> Shop More
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm my-4">
            <div class="display-1 text-muted"><i class="bi bi-box2"></i></div>
            <h4 class="fw-bold mt-3">No orders placed yet</h4>
            <p class="text-muted">You haven't made any purchases with us yet.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary rounded-pill px-4">Start Shopping</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model)
            {
                <div class="card border rounded-4 shadow-sm overflow-hidden bg-white">
                    <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center py-3 px-4 border-bottom">
                        <div class="d-flex flex-wrap gap-4">
                            <div>
                                <small class="text-muted d-block">Order Placed</small>
                                <span class="fw-semibold small">@order.OrderDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div>
                                <small class="text-muted d-block">Total</small>
                                <span class="fw-bold text-dark small">₹@order.GrandTotal.ToString("N2")</span>
                            </div>
                            <div>
                                <small class="text-muted d-block">Order #</small>
                                <span class="fw-semibold small">@order.OrderNumber</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                            @{
                                string badgeClass = order.Status switch
                                {
                                    OrderStatus.Delivered => "bg-success text-white",
                                    OrderStatus.Cancelled => "bg-danger text-white",
                                    OrderStatus.Shipped => "bg-info text-dark",
                                    _ => "bg-primary text-white"
                                };
                            }
                            <span class="badge @badgeClass px-3 py-2">@order.Status</span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3 mb-3 mb-md-0">
                                <img src="@order.FirstProductImage" alt="Order Product" class="rounded-3 border" style="width: 70px; height: 70px; object-fit: cover;" />
                                <div>
                                    <h6 class="fw-bold mb-1">@order.TotalItems @(order.TotalItems == 1 ? "Item" : "Items") in package</h6>
                                    <div class="text-muted small mb-1">Payment: @order.PaymentMethod (@order.PaymentStatus)</div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                        @if (!string.IsNullOrEmpty(order.CourierPartner))
                                        {
                                            <span class="badge bg-light text-dark border font-monospace small"><i class="bi bi-truck text-primary me-1"></i>@order.CourierPartner</span>
                                        }
                                        @if (!string.IsNullOrEmpty(order.TrackingNumber))
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace small">AWB: @order.TrackingNumber</span>
                                        }
                                        @if (order.Status != OrderStatus.Delivered && order.Status != OrderStatus.Cancelled)
                                        {
                                            <span class="text-success small fw-semibold"><i class="bi bi-clock-history me-1"></i>ETA: @(order.EstimatedDeliveryDate?.ToString("dd MMM") ?? order.OrderDate.AddDays(3).ToString("dd MMM"))</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Invoice" asp-route-id="@order.Id" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    <i class="bi bi-file-earmark-text me-1"></i> Invoice
                                </a>
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-primary btn-sm rounded-pill px-4">
                                    <i class="bi bi-eye me-1"></i> View & Track
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
