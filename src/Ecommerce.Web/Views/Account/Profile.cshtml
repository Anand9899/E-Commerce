@model UserProfileVM
@{
    ViewData["Title"] = "My Profile & Account Details";
}

<div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile" class="text-decoration-none">My Account</a></li>
            <li class="breadcrumb-item active" aria-current="page">Profile Details</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-4">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white text-center mb-4">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    @if (Model.Gender == "Female")
                    {
                        <img src="~/images/avatars/female-avatar.png" asp-append-version="true"
                             class="rounded-circle shadow-sm border border-3 border-danger-subtle" width="105" height="105" style="object-fit:cover; object-position:top;" alt="Woman Avatar" />
                        <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-danger shadow-sm px-2 py-1" title="Female">
                            <i class="bi bi-gender-female"></i>
                        </span>
                    }
                    else if (Model.Gender == "Male")
                    {
                        <img src="~/images/avatars/male-avatar.png" asp-append-version="true"
                             class="rounded-circle shadow-sm border border-3 border-primary-subtle" width="105" height="105" style="object-fit:cover; object-position:top;" alt="Man Avatar" />
                        <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-primary shadow-sm px-2 py-1" title="Male">
                            <i class="bi bi-gender-male"></i>
                        </span>
                    }
                    else
                    {
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@(Uri.EscapeDataString(Model.FullName))&backgroundColor=d1d4f9" 
                             class="rounded-circle shadow-sm border border-3 border-secondary-subtle" width="105" height="105" alt="User Avatar" />
                    }
                </div>

                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <p class="text-muted small mb-2">@Model.Email</p>

                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                        <i class="bi bi-shield-check me-1"></i> @Model.Role
                    </span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                        <i class="bi bi-person-check me-1"></i> Active
                    </span>
                </div>

                <div class="text-muted small mb-3">
                    <i class="bi bi-calendar3 me-1"></i> Member Since: 
                    <strong>@(Model.CreatedAt != default ? Model.CreatedAt.ToString("dd MMM yyyy") : "Recent")</strong>
                </div>

                <div class="row g-2 border-top pt-3 text-center">
                    <div class="col-4 border-end">
                        <a asp-controller="Orders" asp-action="Index" class="text-decoration-none">
                            <div class="fw-bold fs-5 text-primary">@Model.TotalOrders</div>
                            <small class="text-muted" style="font-size: 0.75rem;">Orders</small>
                        </a>
                    </div>
                    <div class="col-4 border-end">
                        <a asp-controller="Wishlist" asp-action="Index" class="text-decoration-none">
                            <div class="fw-bold fs-5 text-danger">@Model.WishlistCount</div>
                            <small class="text-muted" style="font-size: 0.75rem;">Wishlist</small>
                        </a>
                    </div>
                    <div class="col-4">
                        <a asp-action="Addresses" class="text-decoration-none">
                            <div class="fw-bold fs-5 text-warning">@Model.AddressCount</div>
                            <small class="text-muted" style="font-size: 0.75rem;">Addresses</small>
                        </a>
                    </div>
                </div>
            </div>

            <div class="list-group rounded-4 shadow-sm border-0 overflow-hidden mb-4">
                <a asp-action="Profile" class="list-group-item list-group-item-action active py-3 fw-semibold">
                    <i class="bi bi-person-lines-fill me-2"></i> Profile Details & Overview
                </a>
                <a asp-action="Wallet" class="list-group-item list-group-item-action py-3">
                    <i class="bi bi-wallet2 me-2 text-success"></i> My Wallet & Rewards
                </a>
                <a asp-controller="Orders" asp-action="Index" class="list-group-item list-group-item-action py-3">
                    <i class="bi bi-box-seam me-2 text-primary"></i> My Orders
                </a>
                <a asp-action="Addresses" class="list-group-item list-group-item-action py-3">
                    <i class="bi bi-geo-alt me-2 text-warning"></i> Saved Addresses
                </a>
                <a asp-controller="Wishlist" asp-action="Index" class="list-group-item list-group-item-action py-3">
                    <i class="bi bi-heart me-2 text-danger"></i> My Wishlist
                </a>
                <a asp-controller="Home" asp-action="Contact" class="list-group-item list-group-item-action py-3">
                    <i class="bi bi-chat-left-dots-fill me-2 text-info"></i> Inquiry & Support
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="list-group-item list-group-item-action py-3 text-danger border-0 w-100 text-start">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </button>
                </form>
            </div>
        </div>

        <!-- Main Profile Content -->
        <div class="col-lg-8">
            <!-- 1. All Details Card -->
            <div class="card border-0 rounded-4 shadow-sm p-4 p-md-4 bg-white mb-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <div>
                        <h4 class="fw-bold mb-1"><i class="bi bi-person-badge text-primary me-2"></i>Profile Information Details</h4>
                        <p class="text-muted small mb-0">Complete overview of your registered account details</p>
                    </div>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                        <i class="bi bi-check2-circle text-success me-1"></i> Verified Account
                    </span>
                </div>

                <div class="row g-3">
                    <!-- Full Name -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4 border h-100">
                            <small class="text-muted d-block mb-1"><i class="bi bi-person me-1"></i> Full Name</small>
                            <span class="fw-bold text-dark fs-6">@Model.FullName</span>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4 border h-100">
                            <small class="text-muted d-block mb-1"><i class="bi bi-envelope me-1"></i> Email Address</small>
                            <span class="fw-bold text-dark fs-6 text-break">@Model.Email</span>
                        </div>
                    </div>

                    <!-- Phone Number -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4 border h-100">
                            <small class="text-muted d-block mb-1"><i class="bi bi-telephone me-1"></i> Mobile Number</small>
                            <span class="fw-bold text-dark fs-6">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not set" : Model.PhoneNumber)</span>
                        </div>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4 border h-100">
                            <small class="text-muted d-block mb-1"><i class="bi bi-gender-ambiguous me-1"></i> Gender</small>
                            @if (Model.Gender == "Female")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-gender-female me-1"></i> Female (Woman)
                                </span>
                            }
                            else if (Model.Gender == "Male")
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-gender-male me-1"></i> Male (Man)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill fw-semibold">
                                    @(Model.Gender ?? "Other")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Edit Profile Form Card -->
            <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <div>
                        <h4 class="fw-bold mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Profile Details</h4>
                        <p class="text-muted small mb-0">Update your personal account information</p>
                    </div>
                </div>

                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Email Address (Login ID)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control bg-light" readonly />
                            </div>
                            <small class="text-muted">Email address cannot be changed.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Full Name *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control" style="text-transform: capitalize;" oninput="autoCapitalizeWords(this)" onblur="autoCapitalizeWords(this)" required placeholder="Your full name" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Gender *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-gender-ambiguous"></i></span>
                                <select asp-for="Gender" class="form-select" required>
                                    <option value="Male">👨 Male</option>
                                    <option value="Female">👩 Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Mobile Phone Number *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted"><i class="bi bi-telephone"></i></span>
                                <span class="input-group-text bg-light fw-bold text-dark border-end-0 px-2" style="user-select: none; font-size: 0.95rem;">+91</span>
                                <input asp-for="PhoneNumber" class="form-control border-start-0 ps-2" required maxlength="10" pattern="[0-9]{10}" inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" placeholder="9876543210" />
                            </div>
                            <small class="text-muted">10-digit mobile number.</small>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold small text-muted">Custom Avatar Image URL (Optional)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-image"></i></span>
                                <input asp-for="AvatarUrl" class="form-control" placeholder="https://..." />
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Save Changes
                        </button>
                        <a asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function autoCapitalizeWords(input) {
            if (!input || !input.value) return;
            var words = input.value.split(" ");
            for (var i = 0; i < words.length; i++) {
                if (words[i].length > 0) {
                    words[i] = words[i].charAt(0).toUpperCase() + words[i].slice(1);
                }
            }
            input.value = words.join(" ");
        }
    </script>
}
