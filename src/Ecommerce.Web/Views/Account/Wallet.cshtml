@model Ecommerce.Application.DTOs.WalletSummaryVM
@{
    ViewData["Title"] = "My Cartivo Wallet & Rewards";
}

<div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Profile" class="text-decoration-none">My Account</a></li>
            <li class="breadcrumb-item active" aria-current="page">Wallet & Rewards</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-wallet2 text-primary me-2"></i>Cartivo Wallet & Rewards Hub</h2>
            <p class="text-muted mb-0">Use your wallet balance for instant checkouts & earn loyalty cashbacks on every purchase.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#topUpModal">
                <i class="bi bi-plus-circle me-1"></i> Add Money
            </button>
            <button type="button" class="btn btn-outline-warning text-dark fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#redeemPointsModal">
                <i class="bi bi-stars text-warning me-1"></i> Convert Points
            </button>
        </div>
    </div>

    <!-- Cards Row -->
    <div class="row g-4 mb-4">
        <!-- 1. Digital Wallet Glassmorphism Card -->
        <div class="col-lg-7">
            <div class="card border-0 rounded-4 shadow-lg text-white p-4 h-100 position-relative overflow-hidden" 
                 style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #000428 100%); min-height: 230px;">
                <!-- Decorative background elements -->
                <div class="position-absolute" style="top: -40px; right: -40px; width: 180px; height: 180px; background: rgba(255,255,255,0.08); border-radius: 50%;"></div>
                <div class="position-absolute" style="bottom: -50px; left: 30%; width: 140px; height: 140px; background: rgba(255,255,255,0.05); border-radius: 50%;"></div>

                <div class="d-flex justify-content-between align-items-start position-relative z-1 mb-3">
                    <div>
                        <span class="badge bg-white bg-opacity-25 text-white px-3 py-2 rounded-pill small">
                            <i class="bi bi-shield-lock-fill me-1 text-info"></i> Official Store Wallet
                        </span>
                    </div>
                    <div class="text-end">
                        <span class="fw-bold fs-4 tracking-wider" style="letter-spacing: 2px;">CARTIVO<span class="text-warning">Pay</span></span>
                    </div>
                </div>

                <div class="position-relative z-1 my-auto">
                    <div class="text-white-50 small mb-1">AVAILABLE BALANCE</div>
                    <div class="display-5 fw-bold text-white mb-2">₹@Model.WalletBalance.ToString("N2")</div>
                </div>

                <div class="d-flex justify-content-between align-items-end position-relative z-1 pt-2 border-top border-white border-opacity-25">
                    <div>
                        <div class="text-white-50" style="font-size: 0.75rem;">CARD HOLDER</div>
                        <div class="fw-semibold small">@Model.FullName</div>
                    </div>
                    <div class="text-end">
                        <div class="text-white-50" style="font-size: 0.75rem;">MEMBER SINCE</div>
                        <div class="fw-semibold small">@Model.MemberSince.ToString("MMM yyyy")</div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-patch-check-fill me-1"></i>Active</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Loyalty Rewards Points Summary Card -->
        <div class="col-lg-5">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100 bg-white d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-bold">
                            <i class="bi bi-award-fill me-1"></i> Cartivo Rewards
                        </span>
                        <span class="text-muted small">1 Point = ₹1.00</span>
                    </div>

                    <h5 class="fw-bold mb-1">Loyalty Points Balance</h5>
                    <p class="text-muted small mb-3">Earn 5% points on every order. Convert them to store wallet cash anytime!</p>

                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-4 mb-3 border">
                        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center shadow-sm" style="width: 54px; height: 54px; font-size: 1.5rem;">
                            <i class="bi bi-stars"></i>
                        </div>
                        <div>
                            <div class="fs-3 fw-bold text-dark mb-0">@Model.LoyaltyPoints <span class="fs-6 fw-normal text-muted">Pts</span></div>
                            <small class="text-success fw-semibold"><i class="bi bi-arrow-right-short"></i> Worth ₹@Model.LoyaltyPoints.ToString("N2") Store Credit</small>
                        </div>
                    </div>
                </div>

                <div>
                    <button class="btn btn-warning w-100 rounded-pill fw-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#redeemPointsModal" @(Model.LoyaltyPoints < 10 ? "disabled" : "")>
                        <i class="bi bi-arrow-repeat me-1"></i> @(Model.LoyaltyPoints < 10 ? "Min 10 Points to Convert" : "Convert Points to Wallet Cash")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Top-Up Banner -->
    <div class="card border-0 rounded-4 shadow-sm bg-primary-subtle p-4 mb-4">
        <div class="row align-items-center g-3">
            <div class="col-md-7">
                <h5 class="fw-bold text-primary mb-1"><i class="bi bi-lightning-charge-fill me-2"></i>Instant Wallet Top-Up</h5>
                <p class="text-secondary small mb-0">Select a quick preset amount to recharge your Cartivo Wallet balance instantly.</p>
            </div>
            <div class="col-md-5">
                <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                    <form asp-action="TopUpWallet" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Amount" value="500" />
                        <input type="hidden" name="PaymentMethod" value="UPI / Instant" />
                        <button type="submit" class="btn btn-white bg-white text-primary border border-primary-subtle rounded-pill px-3 shadow-sm fw-bold">
                            + ₹500
                        </button>
                    </form>
                    <form asp-action="TopUpWallet" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Amount" value="1000" />
                        <input type="hidden" name="PaymentMethod" value="UPI / Instant" />
                        <button type="submit" class="btn btn-white bg-white text-primary border border-primary-subtle rounded-pill px-3 shadow-sm fw-bold">
                            + ₹1,000
                        </button>
                    </form>
                    <form asp-action="TopUpWallet" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Amount" value="2000" />
                        <input type="hidden" name="PaymentMethod" value="UPI / Instant" />
                        <button type="submit" class="btn btn-primary rounded-pill px-3 shadow-sm fw-bold">
                            + ₹2,000
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction History Table -->
    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Wallet Transaction History</h5>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">@Model.Transactions.Count Transactions</span>
        </div>

        @if (!Model.Transactions.Any())
        {
            <div class="text-center py-5">
                <div class="display-3 text-muted opacity-50 mb-3"><i class="bi bi-receipt-cutoff"></i></div>
                <h5 class="fw-bold text-dark">No transactions yet</h5>
                <p class="text-muted small">Top up your wallet or place orders to see your transaction statements here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th scope="col" class="py-3">Type</th>
                            <th scope="col" class="py-3">Description</th>
                            <th scope="col" class="py-3">Amount</th>
                            <th scope="col" class="py-3">Order Ref</th>
                            <th scope="col" class="py-3 text-end">Date & Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in Model.Transactions)
                        {
                            <tr>
                                <td>
                                    @if (txn.IsCredit)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold">
                                            <i class="bi bi-arrow-down-left me-1"></i> Credit
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 fw-semibold">
                                            <i class="bi bi-arrow-up-right me-1"></i> Debit
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@txn.Description</div>
                                    <small class="text-muted">Transaction ID: #TXN-@txn.Id.ToString("D5")</small>
                                </td>
                                <td>
                                    <div class="fw-bold @(txn.IsCredit ? "text-success" : "text-danger") fs-6">
                                        @(txn.IsCredit ? "+ " : "- ")₹@txn.Amount.ToString("N2")
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(txn.OrderNumber))
                                    {
                                        <a asp-controller="Orders" asp-action="Details" asp-route-orderNumber="@txn.OrderNumber" class="badge bg-light text-primary border text-decoration-none px-2 py-1">
                                            <i class="bi bi-box-seam me-1"></i> @txn.OrderNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="text-dark small fw-semibold">@txn.CreatedAt.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@txn.CreatedAt.ToString("hh:mm tt")</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal: Top-Up Custom Amount -->
<div class="modal fade" id="topUpModal" tabindex="-1" aria-labelledby="topUpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="topUpModalLabel"><i class="bi bi-wallet2 text-primary me-2"></i>Top-Up Cartivo Wallet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="TopUpWallet" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <p class="text-muted small mb-3">Enter the amount you would like to load into your digital wallet.</p>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Recharge Amount (₹)</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light fw-bold">₹</span>
                            <input type="number" name="Amount" class="form-control fw-bold" min="10" max="50000" step="10" value="500" required />
                        </div>
                        <small class="text-muted">Min ₹10 — Max ₹50,000</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Payment Method</label>
                        <select name="PaymentMethod" class="form-select">
                            <option value="UPI / QR Code">UPI (GPay, PhonePe, Paytm)</option>
                            <option value="Credit / Debit Card">Credit / Debit Card</option>
                            <option value="Net Banking">Net Banking</option>
                        </select>
                    </div>

                    <div class="p-3 bg-light rounded-3 small text-muted">
                        <i class="bi bi-shield-check text-success me-1"></i> Safe & Instant recharge. Balance becomes available immediately.
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">Add Money Now</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Convert Loyalty Points to Cash -->
<div class="modal fade" id="redeemPointsModal" tabindex="-1" aria-labelledby="redeemPointsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="redeemPointsModalLabel"><i class="bi bi-stars text-warning me-2"></i>Convert Loyalty Points</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RedeemLoyaltyPoints" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="text-center mb-3">
                        <div class="display-6 fw-bold text-warning mb-1">@Model.LoyaltyPoints Pts</div>
                        <div class="text-muted small">Available Points to Convert (1 Pt = ₹1.00 Cash)</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Points to Convert</label>
                        <input type="number" id="pointsInput" name="Points" class="form-control form-control-lg fw-bold text-center" 
                               min="10" max="@Model.LoyaltyPoints" value="@Model.LoyaltyPoints" required />
                        <div class="d-flex justify-content-between mt-1">
                            <small class="text-muted">Minimum: 10 Pts</small>
                            <small class="text-muted">Maximum: @Model.LoyaltyPoints Pts</small>
                        </div>
                    </div>

                    <div class="alert alert-warning-subtle text-dark border border-warning-subtle rounded-3 p-3 text-center mb-0">
                        <div class="small text-muted mb-1">You will receive in your Wallet:</div>
                        <div class="fs-4 fw-bold text-success" id="cashPreview">₹@Model.LoyaltyPoints.ToString("N2")</div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm fw-bold text-dark" @(Model.LoyaltyPoints < 10 ? "disabled" : "")>Convert to Cash</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const pointsInput = document.getElementById("pointsInput");
        const cashPreview = document.getElementById("cashPreview");

        if (pointsInput && cashPreview) {
            pointsInput.addEventListener("input", function() {
                const val = parseFloat(this.value) || 0;
                cashPreview.textContent = "₹" + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            });
        }
    });
</script>
}
