@model List<AddressVM>
@{
    ViewData["Title"] = "Saved Addresses";
}

<div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Profile">Account</a></li>
            <li class="breadcrumb-item active" aria-current="page">Saved Addresses</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Delivery Addresses (@Model.Count)</h2>
        <button type="button" class="btn btn-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#newAddressModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Address
        </button>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm my-4">
            <div class="display-1 text-muted"><i class="bi bi-geo-alt"></i></div>
            <h4 class="fw-bold mt-3">No saved addresses</h4>
            <p class="text-muted">Add a delivery address for instant checkout.</p>
            <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#newAddressModal">Add Address</button>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var addr in Model)
            {
                <div class="col-md-6">
                    <div class="card p-4 border rounded-4 shadow-sm h-100 bg-white position-relative @(addr.IsDefault ? "border-primary" : "")">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0">@addr.FullName</h5>
                            @if (addr.IsDefault)
                            {
                                <span class="badge bg-primary px-3 py-1">Default Address</span>
                            }
                        </div>

                        <div class="text-muted small mb-3">
                            <div>@addr.AddressLine1</div>
                            @if (!string.IsNullOrEmpty(addr.AddressLine2))
                            {
                                <div>@addr.AddressLine2</div>
                            }
                            <div>@addr.City, @addr.State - @addr.PostalCode</div>
                            <div>@addr.Country</div>
                            <div class="mt-2"><strong>Phone:</strong> @addr.PhoneNumber</div>
                        </div>

                        <div class="d-flex gap-2 mt-auto pt-3 border-top">
                            @if (!addr.IsDefault)
                            {
                                <form asp-action="SetDefaultAddress" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@addr.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3">Set Default</button>
                                </form>
                            }
                            <form asp-action="DeleteAddress" method="post" class="d-inline ms-auto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@addr.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle" onclick="return confirm('Delete this address?');" title="Delete">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- New Address Modal -->
<div class="modal fade" id="newAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <form asp-action="SaveAddress" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add New Delivery Address</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Full Name *</label>
                            <input name="FullName" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Phone Number *</label>
                            <input name="PhoneNumber" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Address Line 1 *</label>
                            <input name="AddressLine1" class="form-control" placeholder="House/Flat No., Street" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Address Line 2 (Optional)</label>
                            <input name="AddressLine2" class="form-control" placeholder="Landmark, Area" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">City *</label>
                            <input name="City" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">State *</label>
                            <input name="State" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">PIN Code *</label>
                            <input name="PostalCode" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Country</label>
                            <input name="Country" class="form-control" value="India" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Address</button>
                </div>
            </form>
        </div>
    </div>
</div>
