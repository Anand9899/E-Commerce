@model LoginVM
@{
    ViewData["Title"] = "Customer Sign In";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border rounded-4 shadow-sm p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <a class="brand-logo justify-content-center mb-2" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-bag-heart-fill text-primary"></i>
                        <span>Cartivo</span>
                    </a>
                    <h4 class="fw-bold">Welcome Back</h4>
                    <p class="text-muted small">Sign in to your account to continue</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="Enter Your Email" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" id="loginPasswordInput" type="password" class="form-control border-end-0" placeholder="Enter Password" required />
                            <button type="button" class="btn btn-outline-secondary bg-white border-start-0" onclick="toggleLoginPassword()" title="Show/Hide Password">
                                <i class="bi bi-eye" id="loginPasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberCheck" />
                            <label class="form-check-label small" for="rememberCheck">Remember me</label>
                        </div>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="small text-primary text-decoration-none fw-semibold">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-bold mb-3 shadow-sm">
                        Sign In
                    </button>
                </form>

                <!-- Demo Credentials Helper -->
                <div class="p-3 bg-light rounded-3 border mb-3 small">
                    <div class="fw-bold mb-1 text-primary"><i class="bi bi-info-circle me-1"></i> Demo Login Accounts:</div>
                    <div><strong>Admin:</strong> admmin123@gmail.com / Admin123</div>
                    <div><strong>Customer:</strong> customer@ecommerce.com / Customer@123</div>
                </div>

                <div class="text-center text-muted small">
                    Don't have an account yet? 
                    <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-primary text-decoration-none">Create Account (Sign Up)</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleLoginPassword() {
            var passInput = document.getElementById('loginPasswordInput');
            var icon = document.getElementById('loginPasswordIcon');
            if (passInput.type === "password") {
                passInput.type = "text";
                icon.className = "bi bi-eye-slash text-primary";
            } else {
                passInput.type = "password";
                icon.className = "bi bi-eye";
            }
        }
    </script>
}

